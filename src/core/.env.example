# --- Django ---
SECRET_KEY=change-me-in-production
# En Vercel DEBUG cae a False (seguro); ponlo explícito por claridad.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (django-environ DATABASE_URL) ---
# En Vercel es OBLIGATORIA y DEBE ser Postgres (sqlite no persiste en el
# filesystem serverless de solo lectura): Vercel Postgres, Neon, Supabase, etc.
DATABASE_URL=postgres://dionisio:dionisio@localhost:5432/dionisio

# --- Vercel (lo pone la plataforma; se lista aquí como referencia) ---
# VERCEL=1 cambia el logging a solo-consola y STATIC_ROOT a /tmp, y hace que la
# app confíe automáticamente en VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL para
# hosts/CSRF.
# VERCEL=1

# --- Logging ---
LOG_DIR=logs

# --- CORS / CSRF (landing 5174, backoffice 5173, etc.) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# En producción incluye el origen del frontend Y el origen https de la propia
# API para que el login del admin funcione, p. ej. https://dionisio-backend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Verificación de cuenta por código universal ---
# Código único que simula la verificación por correo mientras no haya backend de
# email. Rótalo/elimínalo antes de producción.
EMAIL_VERIFICATION_UNIVERSAL_CODE=979797

# --- Parámetros de juego (HU-09) ---
TURN_DURATION_SECONDS=60
STEAL_WINDOW_SECONDS=10
SPEED_BONUS_THRESHOLD_SECONDS=20
SPECIAL_ROUND_INTERVAL=3
LIGHTNING_ROUND_DURATION_SECONDS=30

# --- OMDb (omdbapi.com) ---
OMDB_API_KEY=
OMDB_API_BASE_URL=https://www.omdbapi.com
OMDB_IMAGE_BASE_URL=https://img.omdbapi.com
# Términos usados para poblar el catálogo (OMDb solo busca por término).
OMDB_SEARCH_TERMS=star,love,night,world,man,life,war,dark,king,dead
# Año mínimo de estreno admitido en el catálogo (se descartan películas previas).
OMDB_MIN_YEAR=1990

# --- Wikidata (títulos en español; datos CC0, sin restricciones de almacenamiento) ---
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# Wikimedia exige un User-Agent descriptivo con contacto. Cámbialo por el tuyo.
WIKIDATA_USER_AGENT=DionisioBot/1.0 (https://dionisio.app; contacto@dionisio.app)

# --- Estáticos / Media ---
STATIC_URL=static/
MEDIA_URL=/media/

# --- Storage de media en Cloudflare R2 (ver core/settings_storages.py) ---
# Deja USE_R2 sin poner/False para desarrollo local (la media queda en disco).
# Pon USE_R2=True y rellena las credenciales en producción/Vercel.
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Opcional: sobrescribe el endpoint derivado de R2_ACCOUNT_ID.
R2_ENDPOINT_URL=
# Host público que sirve los objetos (subdominio r2.dev o dominio propio).
R2_PUBLIC_URL=

# --- Endurecimiento de seguridad para producción (cuando DEBUG=False) ---
SECURE_HSTS_SECONDS=31536000
