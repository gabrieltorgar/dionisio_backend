# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (django-environ DATABASE_URL) ---
DATABASE_URL=postgres://dionisio:dionisio@localhost:5432/dionisio

# --- Logging ---
LOG_DIR=logs

# --- CORS (landing 5174, backoffice 5173, etc.) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Parámetros de juego (HU-09) ---
TURN_DURATION_SECONDS=60
STEAL_WINDOW_SECONDS=10
SPEED_BONUS_THRESHOLD_SECONDS=20
SPECIAL_ROUND_INTERVAL=3
LIGHTNING_ROUND_DURATION_SECONDS=30

# --- OMDb (omdbapi.com) ---
OMDB_API_KEY=
OMDB_API_BASE_URL=https://www.omdbapi.com
OMDB_IMAGE_BASE_URL=https://img.omdbapi.com
# Términos usados para poblar el catálogo (OMDb solo busca por término).
OMDB_SEARCH_TERMS=star,love,night,world,man,life,war,dark,king,dead
# Año mínimo de estreno admitido en el catálogo (se descartan películas previas).
OMDB_MIN_YEAR=1990

# --- Wikidata (títulos en español; datos CC0, sin restricciones de almacenamiento) ---
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# Wikimedia exige un User-Agent descriptivo con contacto. Cámbialo por el tuyo.
WIKIDATA_USER_AGENT=DionisioBot/1.0 (https://dionisio.app; contacto@dionisio.app)

# --- Storage (S3 en producción) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
